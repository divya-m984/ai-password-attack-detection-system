# Copy this file to .env and adjust values for local development.
# The .env file is excluded from version control — never commit it.

# Active environment: development | testing | production
PAD_ENVIRONMENT=development

# Debug mode (set true only in local development)
PAD_DEBUG=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
PAD_LOG_LEVEL=INFO

# Global random seed for reproducible experiments
PAD_RANDOM_SEED=42

# Override project directories (defaults to repo-relative paths)
# PAD_DATA_DIR=/path/to/data
# PAD_ARTIFACTS_DIR=/path/to/artifacts
# PAD_MODELS_DIR=/path/to/models
# PAD_REPORTS_DIR=/path/to/reports
