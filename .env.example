# Copy this file to .env and adjust values for local development.
# The .env file is excluded from version control — never commit it.
#
# This file is for running the tools and the services *from a checkout*. The
# containerized demonstration does not read it: its environment is declared in
# compose.yaml, and `.env` is excluded from the build context entirely, so a
# local file cannot change what a container serves. See docs/docker.md.
#
# A *server* deployment uses a different file again: `.env.deploy`, created from
# `.env.deploy.example`, carrying a hostname, a publish specification and a
# routing-policy selection. It is untracked, holds no secret and nothing
# scientific, and Compose only reads it when it is passed explicitly with
# --env-file. See docs/deployment.md.
#
# Nothing here is a secret, and nothing here may become one. This project's
# services accept no credential material, so a value in this file would be one
# with nowhere to go and a file to leak out of.

# Active environment: development | testing | production
PAD_ENVIRONMENT=development

# Debug mode (set true only in local development)
PAD_DEBUG=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
PAD_LOG_LEVEL=INFO

# Global random seed for reproducible experiments
PAD_RANDOM_SEED=42

# Override project directories (defaults to repo-relative paths)
# PAD_DATA_DIR=/path/to/data
# PAD_ARTIFACTS_DIR=/path/to/artifacts
# PAD_MODELS_DIR=/path/to/models
# PAD_REPORTS_DIR=/path/to/reports
